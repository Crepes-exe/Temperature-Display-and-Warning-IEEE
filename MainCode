#include <OneWire.h>
#include <DallasTemperature.h>
#include <LiquidCrystal.h>
LiquidCrystal lcd(7, 5, 10, 11, 12, 13);
#define pin 4
float temp;
OneWire oneWire(pin);      
DallasTemperature sensors(&oneWire);
void setup() {
  // put your setup code here, to run once:
  lcd.begin(16, 2);
  pinMode(2,OUTPUT);
  lcd.clear();
  Serial.begin(9600);
  sensors.begin();
}

void loop() {
  // put your main code here, to run repeatedly:
  sensors.requestTemperatures();
  temp = sensors.getTempCByIndex(0);
  Serial.println(temp);
  lcd.setCursor(0, 1);
  lcd.print(temp);
  if (temp>60) {
    digitalWrite(2,HIGH);
  }
  if (temp<60) {

   digitalWrite(2,LOW);
  }
}
